{
  "id": "io.piphi.solaredge.production-summary",
  "name": "SolarEdge production summary",
  "version": "0.1.0",
  "entry": "./dist/widget.js",
  "binding_modes": ["read"],
  "value_kinds": ["numeric"],
  "capability_requirements": ["today_energy_kwh", "month_energy_kwh", "year_energy_kwh", "lifetime_energy_kwh"],
  "sdk_compatibility": {"minimum": "0.3.0"},
  "conformance": {
    "accessibility": "wcag2.2-aa", "keyboard": true, "themes": ["light", "dark"],
    "directions": ["ltr", "rtl"],
    "states": ["loading", "live", "stale", "offline", "reconnecting", "denied", "error"]
  },
  "settings_schema_version": "1",
  "settings": [
    {"id": "title", "type": "text", "label": "Title", "default": "Solar production"},
    {"id": "site", "type": "device", "label": "SolarEdge site", "required": true}
  ],
  "layout": {"min_height": 180, "default_height": 260, "max_height": 460},
  "previews": {"light": "./previews/light.svg", "dark": "./previews/dark.svg"},
  "translations": {
    "en": {"widget.title": "Solar production", "widget.waiting": "Waiting for SolarEdge totals"},
    "es": {"widget.title": "Producción solar", "widget.waiting": "Esperando los totales de SolarEdge"},
    "ar": {"widget.title": "إنتاج الطاقة الشمسية", "widget.waiting": "في انتظار إجماليات SolarEdge"}
  },
  "security": {"permissions": [], "sandbox": ["allow-scripts"], "csp": {"connect_src": []}}
}
